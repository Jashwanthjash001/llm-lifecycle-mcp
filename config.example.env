# Point these at your own setup. Copy to config.env (gitignored) or pass via the
# MCP client's "env" block. Only EDGE_AI_ROOT is required; the rest enable extra tools.

# llama.cpp bundle: bin/, models/, results/, bench.sh (the local-document-assistant/serving dir works)
EDGE_AI_ROOT=/path/to/local-document-assistant/serving

# Local RAG app (FastAPI). Leave empty to disable search_documents / ask_documents.
RAG_API_URL=http://localhost:8000

# vLLM server for read-only metrics. Leave empty to disable the serving tools.
VLLM_URL=

# serving-lab results dir parent, for recommend_config. Leave empty to disable.
SERVING_LAB_ROOT=/path/to/llm-serving-optimization-lab
